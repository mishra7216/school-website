{
  "rewrites": [
    { "source": "/((?!.*\\.(?:js|css|json|ico|png|jpg|jpeg|webp|svg|gif|pdf|xml|txt|JPG|woff|woff2|ttf|eot)$).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    },
    {
      "source": "/(.+\\.(?:jpg|jpeg|png|gif|webp|svg|ico|JPG)$)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.+\\.(?:js|css)$)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
